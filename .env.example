# Configuração local do PostgreSQL. Use uma senha longa com caracteres seguros em URL,
# pois o Compose monta DATABASE_URL para a API a partir destas variáveis.
POSTGRES_DB=agrofin
POSTGRES_USER=agrofin
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria-hexadecimal
POSTGRES_PORT=5432

# Prefixo comum às rotas da API e ao proxy do frontend.
API_PREFIX=/api/v1

# Defina um segredo aleatório de uso único para liberar POST ${API_PREFIX}/auth/register.
# Exemplo: 64 caracteres hexadecimais gerados por um gerador criptográfico.
AUTH_SETUP_TOKEN=

# Portas publicadas apenas no localhost da máquina de desenvolvimento.
API_PORT=8080
WEB_PORT=5173

# Banco exclusivo para os testes da API; mantenha usuário, senha e porta alinhados às variáveis acima.
TEST_DATABASE_URL=postgres://agrofin:troque-por-uma-senha-aleatoria-hexadecimal@127.0.0.1:5432/agrofin_test?sslmode=disable
